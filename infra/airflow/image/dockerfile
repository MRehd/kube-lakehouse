ARG AIRFLOW_VERSION=3.2.0
ARG PYTHON_VERSION=3.12

FROM apache/airflow:${AIRFLOW_VERSION}-python${PYTHON_VERSION}

# Re-declare after FROM so the values are visible in the RUN below.
ARG AIRFLOW_VERSION
ARG PYTHON_VERSION

COPY requirements.txt /tmp/requirements.txt

RUN pip install --no-cache-dir \
    --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-${AIRFLOW_VERSION}/constraints-${PYTHON_VERSION}.txt" \
    -r /tmp/requirements.txt

# Airflow constraints pin protobuf to 4.x (most providers want it there), but
# pyspark 4.x's Spark Connect proto bindings import google.protobuf.runtime_version
# which only exists in protobuf >=5.26. Bump it after the constrained install.
RUN pip install --no-cache-dir --upgrade 'protobuf>=5.27,<6'
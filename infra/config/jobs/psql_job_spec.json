{
  "ttlSecondsAfterFinished": 300,
  "backoffLimit": 3,
  "template": {
    "spec": {
      "restartPolicy": "OnFailure",
      "containers": [
        {
          "name": "psql",
          "image": "postgres:16-alpine",
          "command": ["sh", "-c", "until pg_isready -h $PGHOST -p $PGPORT -U $PGUSER; do echo 'waiting for postgres...'; sleep 3; done && echo \"$SQL_SCRIPT\" | psql -v ON_ERROR_STOP=1"],
          "env": [
            {"name": "PGHOST", "value": ""},
            {"name": "PGPORT", "value": "5432"},
            {"name": "PGUSER", "value": "postgres"},
            {"name": "PGPASSWORD", "valueFrom": {"secretKeyRef": {"name": "", "key": "password"}}},
            {"name": "SQL_SCRIPT", "value": ""}
          ]
        }
      ]
    }
  }
}

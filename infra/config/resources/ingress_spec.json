{
  "ingressClassName": "nginx",
  "rules": [
    {
      "host": "app.local",
      "http": {
        "paths": [
          {
            "path": "/",
            "pathType": "Prefix",
            "backend": {
              "service": {
                "name": "service",
                "port": {"number": 8080}
              }
            }
          }
        ]
      }
    }
  ]
}

{
  "fullnameOverride": "",
  "replicaCount": 1,
  "service": {
    "type": "ClusterIP",
    "port": 80,
    "containerPort": 5000
  },
  "resources": {
    "requests": { "cpu": "200m", "memory": "512Mi" },
    "limits":   { "cpu": "1000m", "memory": "1Gi" }
  },
  "backendStore": {
    "postgres": {
      "enabled": true,
      "port": 5432
    }
  },
  "artifactRoot": {
    "s3": {
      "enabled": true
    }
  },
  "ingress": {
    "enabled": false,
    "className": "nginx",
    "hosts": []
  },
  "log": {
    "enabled": false
  },
  "extraArgs": {
    "allowedHosts": "*"
  }
}

{
  "ollama": {
    "enabled": false
  },
  "service": {
    "type": "ClusterIP",
    "port": 80,
    "containerPort": 8080
  },
  "resources": {
    "requests": { "cpu": "200m", "memory": "512Mi" },
    "limits":   { "cpu": "500m", "memory": "1Gi" }
  },
  "persistence": {
    "enabled": true,
    "size": "2Gi"
  },
  "ingress": {
    "enabled": false,
    "class": "nginx",
    "host": ""
  }
}

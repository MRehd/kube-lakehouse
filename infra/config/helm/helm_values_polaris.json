{
  "fullnameOverride": "{{RELEASE_NAME}}",
  "replicaCount": 1,
  "image": {
    "repository": "apache/polaris",
    "tag": "latest",
    "pullPolicy": "IfNotPresent"
  },
  "service": {
    "type": "LoadBalancer",
    "ports": [{"name": "polaris-http", "port": 8181}]
  },
  "managementService": {
    "ports": [{"name": "polaris-mgmt", "port": 8182}]
  },
  "resources": {
    "requests": {"memory": "512Mi", "cpu": "250m"},
    "limits": {"memory": "1Gi", "cpu": "500m"}
  },
  "realmContext": {
    "type": "default",
    "realms": ["POLARIS"]
  },
  "metrics": {"enabled": true},
  "logging": {
    "level": "INFO",
    "console": {"json": false}
  },
  "autoscaling": {
    "enabled": true,
    "minReplicas": 1,
    "maxReplicas": 2
  },
  "persistence": {"type": "in-memory"},
  "livenessProbe": {
    "initialDelaySeconds": 60,
    "periodSeconds": 15,
    "failureThreshold": 5,
    "timeoutSeconds": 10
  },
  "readinessProbe": {
    "initialDelaySeconds": 60,
    "periodSeconds": 15,
    "failureThreshold": 5,
    "timeoutSeconds": 10
  }
}
